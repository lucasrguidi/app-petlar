# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Full URL of the app (e.g. http://localhost:3001 in dev, https://yourdomain.com in prod)
BETTER_AUTH_URL=http://localhost:3001

# CORS — must match BETTER_AUTH_URL origin
CORS_ORIGIN=http://localhost:3001

# Database (Turso / LibSQL)
# Local: file:./local.db  |  Prod: libsql://<db>-<org>.turso.io
DATABASE_URL=file:./local.db
# Required in prod; leave empty for local file DB
DATABASE_AUTH_TOKEN=

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL of the bucket (e.g. https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=

# Resend (optional — required to send transactional emails)
RESEND_API_KEY=
EMAIL_FROM=

# Dev only — set to "true" to skip email confirmation on signup. NEVER enable in prod.
SKIP_EMAIL_CONFIRMATION=

# Public — shown in the UI for support contact
NEXT_PUBLIC_SUPPORT_WHATSAPP=
