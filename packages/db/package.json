{
  "name": "@app-petlar/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:local": "turso dev --db-file local.db",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/seed.ts",
    "db:seed:preview": "tsx src/seed-preview.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@app-petlar/env": "workspace:*",
    "@libsql/client": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "libsql": "catalog:",
    "nanoid": "^5.1.6",
    "oslo": "^1.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@app-petlar/config": "workspace:*",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.19.0",
    "typescript": "catalog:"
  }
}
